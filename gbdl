#!/usr/bin/env bash
#
# gbdl - an interactive translator on top of `ollama run gemma3:12b`.
#
# Usage: gbdl [j|e|g]
#   j  translate into Japanese (default)
#   e  translate into English
#   g  translate into German
#
# Type text, press Enter, get the translation. Quit with Ctrl-D or Ctrl-C.

set -uo pipefail

readonly DEFAULT_MODEL="gemma3:12b"
readonly MODEL="${GBDL_MODEL:-$DEFAULT_MODEL}"
readonly DEFAULT_LANGUAGE="Japanese"
readonly SERVER_START_TIMEOUT_SECONDS=30
readonly SERVER_POLL_INTERVAL_SECONDS=0.3
readonly EXIT_USAGE=2
readonly EXIT_UNAVAILABLE=69
readonly EXIT_INTERRUPTED=130

# How long to keep collecting lines after the first one before deciding the
# input is finished. A paste arrives in one burst and is collected whole; a
# human typing pauses far longer than this. Bash 3.2 has neither fractional
# `read` timeouts nor `read -t 0`, so it falls back to whole seconds and skips
# the unterminated-tail handling below.
if [[ "${BASH_VERSINFO[0]}" -ge 4 ]]; then
  readonly PASTE_DRAIN_SECONDS=0.2
  readonly CAN_PROBE_INPUT=1
else
  readonly PASTE_DRAIN_SECONDS=1
  readonly CAN_PROBE_INPUT=0
fi

# The lines of the input block currently being translated, and whether the last
# of them arrived without a newline, which leaves the cursor mid-line.
BLOCK_LINES=()
BLOCK_UNTERMINATED=0
SAVED_STTY=""

usage() {
  cat <<'USAGE'
Usage: gbdl [j|e|g]

Interactive translator backed by a local Ollama model.

Options:
  j, -j, --japanese   translate into Japanese (default)
  e, -e, --english    translate into English
  g, -g, --german     translate into German
  -h, --help          show this help

Environment:
  GBDL_MODEL          Ollama model to use (default: gemma3:12b)

Quit with Ctrl-D or Ctrl-C.
USAGE
}

log_error() {
  printf 'gbdl: %s\n' "$*" >&2
}

log_info() {
  printf 'gbdl: %s\n' "$*" >&2
}

# Maps a CLI language flag to the language name used in the prompt.
resolve_language() {
  case "$1" in
    j | -j | --japanese) printf '%s' "Japanese" ;;
    e | -e | --english) printf '%s' "English" ;;
    g | -g | --german) printf '%s' "German" ;;
    *) return 1 ;;
  esac
}

parse_language_argument() {
  if [[ $# -eq 0 ]]; then
    printf '%s' "$DEFAULT_LANGUAGE"
    return 0
  fi

  if [[ $# -gt 1 ]]; then
    log_error "too many arguments: expected at most one language option"
    return "$EXIT_USAGE"
  fi

  local language
  if ! language="$(resolve_language "$1")"; then
    log_error "unknown option '$1' (expected j, e or g)"
    return "$EXIT_USAGE"
  fi

  printf '%s' "$language"
}

is_server_running() {
  ollama ps >/dev/null 2>&1
}

# Starts `ollama serve` detached, with stdout/stderr discarded, and waits
# until the server answers.
start_server() {
  log_info "starting ollama serve ..."
  ollama serve >/dev/null 2>&1 &
  disown 2>/dev/null || true

  local waited=0
  while ! is_server_running; do
    sleep "$SERVER_POLL_INTERVAL_SECONDS"
    waited=$((waited + 1))
    local elapsed_seconds
    elapsed_seconds=$(awk "BEGIN { print $waited * $SERVER_POLL_INTERVAL_SECONDS }")
    if awk "BEGIN { exit !($elapsed_seconds >= $SERVER_START_TIMEOUT_SECONDS) }"; then
      log_error "ollama server did not become ready within ${SERVER_START_TIMEOUT_SECONDS}s"
      return "$EXIT_UNAVAILABLE"
    fi
  done

  log_info "ollama server is ready"
}

ensure_server() {
  if ! command -v ollama >/dev/null 2>&1; then
    log_error "'ollama' not found in PATH"
    return "$EXIT_UNAVAILABLE"
  fi

  is_server_running && return 0
  start_server
}

notify_if_model_missing() {
  # Captured first: `grep -q` closes the pipe early, which would make the
  # producer fail under `pipefail` even when the model is installed.
  local installed_models
  installed_models="$(ollama list 2>/dev/null)"

  if ! grep -qF -- "$MODEL" <<<"$installed_models"; then
    log_info "model '$MODEL' is not present locally; it will be pulled on first use"
  fi
}

build_prompt() {
  local language="$1" text="$2"
  printf 'please translate this text in %s, and please print out only the result:\n%s' \
    "$language" "$text"
}

translate() {
  local language="$1" text="$2"
  local prompt
  prompt="$(build_prompt "$language" "$text")"
  # stdin is closed for the child: `ollama run` reads it and would otherwise
  # consume the lines still queued behind the current one (a pasted block).
  ollama run "$MODEL" "$prompt" </dev/null
}

# Readline buffers a bracketed paste in its own line buffer and throws away
# everything after the first newline, so a pasted paragraph would reach the
# translator as its first line only. With the mode off the terminal delivers a
# paste as ordinary lines that `read` consumes one by one, and arrow keys and
# history keep working.
#
# The mode is turned off by a generated inputrc that still includes the user's
# own. Readline reads INPUTRC from the process environment when it initialises,
# and a variable exported from inside a running script never reaches it, so the
# setting can only be applied by re-execing once with the variable already set.
setup_readline() {
  [[ -t 0 ]] || return 0
  [[ -z "${GBDL_INPUTRC:-}" ]] || return 0

  local generated="${TMPDIR:-/tmp}/gbdl-inputrc.$$"
  local user_inputrc="${INPUTRC:-$HOME/.inputrc}"
  {
    [[ -r "$user_inputrc" ]] && printf '$include %s\n' "$user_inputrc"
    printf 'set enable-bracketed-paste off\n'
  } >"$generated" 2>/dev/null || return 0

  exec env INPUTRC="$generated" GBDL_INPUTRC="$generated" "$0" "$@"
}

# Canonical mode releases a line only once its terminating newline arrives, so
# the tail of a paste that ends without one would stay stuck in the terminal's
# buffer, unreachable by `read`. Non-canonical mode releases the bytes as they
# are; `read` then saves what it got into the variable when it times out
# part-way through a line.
begin_raw_input() {
  SAVED_STTY="$(stty -g 2>/dev/null)" || { SAVED_STTY=""; return 1; }
  stty -icanon min 1 time 0 2>/dev/null || { SAVED_STTY=""; return 1; }
}

end_raw_input() {
  [[ -n "$SAVED_STTY" ]] || return 0
  stty "$SAVED_STTY" 2>/dev/null
  SAVED_STTY=""
}

# True when bytes are already waiting to be read.
input_pending() {
  read -r -t 0 2>/dev/null
}

cleanup() {
  end_raw_input
  [[ -n "${GBDL_INPUTRC:-}" ]] && rm -f "$GBDL_INPUTRC"
  return 0
}

is_blank() {
  [[ -z "${1//[[:space:]]/}" ]]
}

# Appends the rest of a paste to BLOCK_LINES.
#
# Nothing is read unless bytes are already waiting at the moment the first line
# was accepted: a paste is sitting in the buffer in its entirety by then, while
# someone typing by hand has not managed a keystroke yet. That check is what
# keeps the next thing the user types from being swallowed into this block.
drain_pending_input() {
  local pending="" line raw=0

  if [[ "$CAN_PROBE_INPUT" -eq 1 ]] && begin_raw_input; then
    if input_pending; then
      raw=1
    else
      end_raw_input
      return 0
    fi
  fi

  while :; do
    line=""
    if IFS= read -r -t "$PASTE_DRAIN_SECONDS" line; then
      BLOCK_LINES+=("$pending$line")
      pending=""
      continue
    fi
    # Timed out. A non-empty variable holds an unterminated line: the rest of
    # it may still be on its way, so hold on to it and look again. Only a
    # window in which nothing at all arrived ends the paste.
    if [[ -n "$line" ]]; then
      pending+="$line"
      continue
    fi
    break
  done

  [[ "$raw" -eq 1 ]] && end_raw_input
  if [[ -n "$pending" ]]; then
    BLOCK_LINES+=("$pending")
    BLOCK_UNTERMINATED=1
  fi
  return 0
}

# Collects one block of input into BLOCK_LINES. On a terminal the first line
# blocks, then the rest of a paste is drained in one go: translating between
# lines would stall for seconds while the remaining pasted text overflows the
# terminal's small input buffer and is silently dropped. Piped input is read
# to EOF. Returns non-zero once there is no more input (Ctrl-D).
read_block() {
  local prompt_label="$1"
  local line=""
  BLOCK_LINES=()
  BLOCK_UNTERMINATED=0

  if [[ -t 0 ]]; then
    IFS= read -r -e -p "$prompt_label" line || [[ -n "$line" ]] || return 1
    BLOCK_LINES+=("$line")
    drain_pending_input
  else
    printf '%s' "$prompt_label"
    while :; do
      line=""
      if ! IFS= read -r line; then
        [[ -n "$line" ]] && BLOCK_LINES+=("$line")
        break
      fi
      BLOCK_LINES+=("$line")
    done
    [[ ${#BLOCK_LINES[@]} -gt 0 ]] || return 1
  fi
}

# Translates one paragraph as a single unit. A hard-wrapped paragraph must not
# be sent line by line: each line is a sentence fragment, and the model can
# only translate what it is given.
translate_paragraph() {
  local language="$1"
  shift
  local text
  text="$(printf '%s\n' "$@")"

  if ! translate "$language" "$text"; then
    log_error "translation failed"
  fi
}

# Prints the block's translation with the shape of the original: runs of
# non-blank lines are translated as one paragraph, blank lines stay blank.
translate_block() {
  local language="$1"
  local -a paragraph=()
  local line

  for line in "${BLOCK_LINES[@]}"; do
    if is_blank "$line"; then
      if [[ ${#paragraph[@]} -gt 0 ]]; then
        translate_paragraph "$language" "${paragraph[@]}"
        paragraph=()
      fi
      printf '\n'
    else
      paragraph+=("$line")
    fi
  done

  if [[ ${#paragraph[@]} -gt 0 ]]; then
    translate_paragraph "$language" "${paragraph[@]}"
  fi
}

block_has_text() {
  local line
  for line in "${BLOCK_LINES[@]}"; do
    is_blank "$line" || return 0
  done
  return 1
}

run_repl() {
  local language="$1"
  local prompt_label="[$language] > "

  while read_block "$prompt_label"; do
    # A paste that ended without a newline leaves the cursor after the echoed
    # text, so start the translation on a line of its own.
    [[ "$BLOCK_UNTERMINATED" -eq 1 ]] && printf '\n'
    translate_block "$language"
    # Separates the result from the next prompt; a block that was nothing but
    # blank lines has already printed them.
    block_has_text && printf '\n'
  done

  printf '\n'
}

main() {
  case "${1-}" in
    -h | --help)
      usage
      return 0
      ;;
  esac

  trap 'printf "\n"; exit '"$EXIT_INTERRUPTED" INT
  trap cleanup EXIT

  local language status
  language="$(parse_language_argument "$@")" || {
    status=$?
    usage >&2
    return "$status"
  }

  # Before any real work: this re-execs the script on its first run.
  setup_readline "$@"

  ensure_server || return $?
  notify_if_model_missing

  log_info "model: $MODEL - quit with Ctrl-D or Ctrl-C"
  run_repl "$language"
}

main "$@"
